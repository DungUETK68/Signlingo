{
  "name": "signlingo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mobile:build": "node scripts/build-mobile-assets.mjs",
    "mobile:sync": "node scripts/build-mobile-assets.mjs && npx cap sync android",
    "mobile:apk": "powershell -ExecutionPolicy Bypass -File ../scripts/build-android-apk.ps1",
    "mobile:apk:release": "powershell -ExecutionPolicy Bypass -File ../scripts/build-android-apk.ps1 -Release",
    "mobile:install": "powershell -ExecutionPolicy Bypass -File ../scripts/build-android-apk.ps1 -Install",
    "mobile:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/holistic": "^0.5.1675471629",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
